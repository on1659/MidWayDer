# ========================================
# MidWayDer 환경 변수 예시
# 이 파일을 복사해 .env.local 을 만드세요:
#   cp .env.example .env.local
# ========================================

# --- Database (PostgreSQL + PostGIS) ---
# Railway 대시보드 > Variables 탭에서 확인
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# --- Map Provider ---
# "kakao" 또는 "naver"
MAP_PROVIDER=kakao
NEXT_PUBLIC_MAP_PROVIDER=kakao

# --- Kakao Maps (Primary) ---
# https://developers.kakao.com > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here

# --- Naver Maps Enterprise (Fallback) ---
# https://console.ncloud.com > AI·NAVER API > Maps
NAVER_MAPS_CLIENT_ID=your_naver_maps_client_id_here
NAVER_MAPS_CLIENT_SECRET=your_naver_maps_client_secret_here
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=your_naver_maps_client_id_here
