{
  "name": "midwayder",
  "version": "0.66.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "analyze": "ANALYZE=true npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "check": "tsx scripts/check-env.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:mobile:ui": "playwright test --project=mobile-chrome tests/e2e/mobile-ui.spec.ts",
    "test:e2e:mobile:visual": "playwright test --project=mobile-chrome tests/e2e/mobile-visual.spec.ts",
    "test:e2e:mobile:update": "playwright test --project=mobile-chrome --update-snapshots",
    "test:prod": "playwright test --config=playwright.prod.config.ts",
    "test:prod:desktop": "playwright test --config=playwright.prod.config.ts --project=chromium-desktop",
    "test:prod:mobile": "playwright test --config=playwright.prod.config.ts --project=mobile-chrome",
    "test:prod:headed": "playwright test --config=playwright.prod.config.ts --headed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sentry/nextjs": "^10.42.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.4",
    "dexie": "^4.3.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
