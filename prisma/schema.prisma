generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Place {
  id           String          @id @default(cuid())
  name         String
  category     String          @db.VarChar(50)
  address      String
  roadAddress  String?
  phone        String?
  lat          Float
  lng          Float
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  kakaoPlaceId String?         @unique
  clicks       ClickLog[]
  feedbacks    VisitFeedback[]

  @@unique([name, category, address])
  @@index([category])
  @@index([lat, lng])
}

model SearchLog {
  id             String           @id @default(cuid())
  startAddress   String
  endAddress     String
  category       String           @db.VarChar(50)
  resultsCount   Int
  searchDuration Int?
  sessionId      String?
  timestamp      DateTime         @default(now())
  clicks         ClickLog[]
  feedback       SearchFeedback?

  @@index([category])
  @@index([timestamp])
  @@index([sessionId])
}

model ClickLog {
  id          String    @id @default(cuid())
  searchLogId String
  placeId     String
  rank        Int
  timestamp   DateTime  @default(now())
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@index([searchLogId])
  @@index([placeId])
  @@index([timestamp])
}

model VisitFeedback {
  id        String   @id @default(cuid())
  placeId   String
  rating    Int
  comment   String?
  sessionId String?
  timestamp DateTime @default(now())
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([timestamp])
  @@index([sessionId])
}

model SearchFeedback {
  id          String    @id @default(cuid())
  searchLogId String    @unique
  helpful     Boolean
  comment     String?
  createdAt   DateTime  @default(now())
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@index([searchLogId])
  @@index([createdAt])
}
