generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Place {
  id           String          @id @default(cuid())
  name         String
  category     String          @db.VarChar(50)
  address      String
  roadAddress  String?
  phone        String?
  lat          Float
  lng          Float
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  kakaoPlaceId String?         @unique
  clicks       ClickLog[]
  feedbacks    VisitFeedback[]
  visitLogs    VisitLog[]
  bookmarks    Bookmark[]

  @@unique([name, category, address])
  @@index([category])
  @@index([lat, lng])
}

model SearchLog {
  id             String           @id @default(cuid())
  startAddress   String
  endAddress     String
  category       String           @db.VarChar(50)
  resultsCount   Int
  searchDuration Int?
  sessionId      String?
  routeHash      String?          // 개인화 추천용: 경로 해시 (출발+도착 좌표)
  timestamp      DateTime         @default(now())
  clicks         ClickLog[]
  feedback       SearchFeedback?

  @@index([category])
  @@index([timestamp])
  @@index([sessionId])
  @@index([routeHash])
}

model ClickLog {
  id          String    @id @default(cuid())
  searchLogId String
  placeId     String
  rank        Int
  sessionId   String?   // 개인화 추천용: 사용자별 클릭 히스토리
  clickedAt   DateTime  @default(now())
  timestamp   DateTime  @default(now())
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@index([searchLogId])
  @@index([placeId])
  @@index([timestamp])
  @@index([sessionId])
  @@index([clickedAt])
}

model VisitFeedback {
  id        String   @id @default(cuid())
  placeId   String
  rating    Int
  comment   String?
  sessionId String?
  timestamp DateTime @default(now())
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([timestamp])
  @@index([sessionId])
}

model SearchFeedback {
  id          String    @id @default(cuid())
  searchLogId String    @unique
  helpful     Boolean
  comment     String?
  createdAt   DateTime  @default(now())
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@index([searchLogId])
  @@index([createdAt])
}

model VisitLog {
  id         String   @id @default(cuid())
  placeId    String
  sessionId  String
  points     Int      @default(10)
  verifiedAt DateTime @default(now())
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([sessionId])
  @@index([verifiedAt])
}

model UserPoints {
  id        String   @id @default(cuid())
  sessionId String   @unique
  points    Int      @default(0)
  tier      String   @default("bronze")
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int // 1-5점
  category  String // "bug" | "suggestion" | "praise"
  comment   String? @db.Text
  userId    String?
  userAgent String?
  url       String? // 피드백 제출한 페이지 URL
  metadata  Json? // 추가 메타데이터 (검색어, 경로 등)
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([rating, createdAt])
}

model PushSubscription {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String    // 공개키
  auth       String    // 인증 시크릿
  userAgent  String?   // 브라우저 정보
  sessionId  String?   // 사용자 식별용
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime? @default(now())

  @@index([endpoint])
  @@index([sessionId])
}

model Bookmark {
  id        String   @id @default(cuid())
  placeId   String
  sessionId String
  memo      String?  @db.Text
  createdAt DateTime @default(now())
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, sessionId])
  @@index([sessionId])
  @@index([createdAt])
}
